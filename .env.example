# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Supabase Credentials (optional for live Supabase backend connection)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Live hospital API endpoint (required for real hospital data)
VITE_HOSPITALS_API_URL="https://your-api-domain.com/api"
# or use VITE_API_BASE_URL="https://your-api-domain.com/api"

